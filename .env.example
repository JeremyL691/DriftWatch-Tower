# Example environment file for the DriftWatch Tower self-host stack.
#
# Do not use these placeholder values for a real deployment and never commit an
# env file containing real credentials. `scripts/selfhost.sh init` generates a
# random password and writes the real file with 0600 permissions.
#
# Copy this file, fill in a strong password, and pass it with --env-file.

# PostgreSQL credentials used by the compose stack.
DWT_POSTGRES_DB=driftwatch
DWT_POSTGRES_USER=driftwatch
DWT_POSTGRES_PASSWORD=replace-with-a-strong-random-value

# Host loopback port for the application (acceptance runs use 18080).
DWT_APP_PORT=8080

# Spring profile: selfhost enables production defaults, including the live GitHub
# public-event collector. Tests and load runs use their own profiles.
DWT_SPRING_PROFILES=selfhost

# Optional overrides:
# DWT_APP_IMAGE=ghcr.io/jeremyl691/driftwatch-tower:v1.0.0
# DWT_KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
# DWT_PG_VOLUME=driftwatch-pgdata
# DWT_KAFKA_VOLUME=driftwatch-kafkadata
# DWT_STREAMS_VOLUME=driftwatch-streams-state
# DWT_NETWORK=driftwatch
